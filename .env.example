# Web Push VAPID credentials. Generate once with: npm run generate-vapid-keys
# VAPID_SUBJECT accepts a bare email (a mailto: prefix is added) or an https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Server-only flight schedule lookup through AeroDataBox on RapidAPI.
AERODATABOX_API_KEY=

# Receipt reading. Netlify's AI Gateway injects OPENAI_API_KEY / OPENAI_BASE_URL
# automatically, so these are only needed to point at a different gateway.
NETLIFY_AI_GATEWAY_KEY=
NETLIFY_AI_GATEWAY_BASE_URL=

# Optional overrides for receipt analysis (defaults: gpt-5.6-luna, 100/user/day).
RECEIPT_MODEL=
RECEIPT_ANALYSIS_DAILY_LIMIT=
