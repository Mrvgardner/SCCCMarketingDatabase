{
  "appId": "team.switchcommerce.tradeshows",
  "appName": "Trade Shows",
  "webDir": "dist",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#030712"
  },
  "server": {
    "iosScheme": "https",
    "allowNavigation": [
      "switchcommerce.team",
      "*.switchcommerce.team",
      "*.netlify.app"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#030712"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
