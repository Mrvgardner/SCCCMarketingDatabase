# Dependencies
node_modules/

# macOS
.DS_Store
# Finder duplicates, e.g. "index-2ac275de 2.js"
* [0-9].*

# Environment
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Auto-generated by prebuild
src/data/celebrations.generated.js

# Tesseract downloads language data from its CDN at runtime; a local copy here
# is a stray artifact from running OCR in Node, not something the app loads.
eng.traineddata

# Netlify CLI local state (site link + generated config cache).
# The deploy reads the root netlify.toml, not this.
.netlify/

# Capacitor native project — generated by `npx cap add ios`, and it contains
# Pods and build output. Regenerate with `npx cap sync ios`.
/ios/App/Pods/
/ios/App/build/
/ios/DerivedData/

# Capacitor copies the whole web build in here on every `cap copy`. Generated,
# large, and it nearly ended up in a commit to main — keep it out of git.
/ios/App/App/public/
